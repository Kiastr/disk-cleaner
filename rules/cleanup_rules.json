{
  "meta": {
    "name": "C盘清理规则库",
    "version": "3.0",
    "generated": "2026-08-13",
    "note": "scope: dirname=匹配目录名 / filename=匹配文件名 / path=匹配完整路径。risk: safe=直接可删 / warning=需LLM确认 / danger=勿删"
  },
  "protect_list": [
    {"pattern": "[A-Z]:[/\\\\](pagefile|swapfile)[.]sys$", "note": "分页/交换文件"},
    {"pattern": "[/\\\\]WinSxS[/\\\\]", "note": "组件存储"},
    {"pattern": "[/\\\\]System32[/\\\\]", "note": "系统目录"},
    {"pattern": "[/\\\\]SysWOW64[/\\\\]", "note": "系统目录"},
    {"pattern": "[/\\\\]System32[/\\\\]config[/\\\\]", "note": "注册表hive"},
    {"pattern": "[/\\\\]Windows[/\\\\](boot|Fonts)[/\\\\]", "note": "引导/字体目录"},
    {"pattern": "[/\\\\]Program Files[/\\\\]", "note": "程序目录"},
    {"pattern": "[/\\\\]Program Files [(]x86[)][/\\\\]", "note": "程序目录"}
  ],
  "rules": [
    {"id": "cache-dirs", "scope": "dirname", "risk": "safe", "category": "缓存目录",
     "pattern": "^(cache|cache_data|code cache|gpucache|dxcache|dx9cache|dx11cache|htmlcache|webcache|localcache|component_crx_cache|crx_cache|shadercache|grshadercache|dawnwebgpucache|dawngraphitecache|cachestorage|blob_storage|gcm store|startupcache|domcache)$",
     "description": "各类浏览器/应用/驱动的缓存目录", "method": "整目录删除"},
    {"id": "crash-dirs", "scope": "dirname", "risk": "safe", "category": "崩溃报告",
     "pattern": "^(crashes|crashpad|crashreport|crashreports|reportqueue|crashdumps|minidump|livekernelreports|reports)$",
     "description": "程序崩溃报告/转储目录", "method": "整目录删除"},
    {"id": "temp-dirs", "scope": "dirname", "risk": "safe", "category": "临时目录",
     "pattern": "^(temp|tmp)$",
     "description": "临时目录", "method": "清空内容"},
    {"id": "log-dirs", "scope": "dirname", "risk": "safe", "category": "日志目录",
     "pattern": "^(logs?|logfiles|update logs|debug logs)$",
     "description": "日志目录", "method": "清空"},
    {"id": "wer-archive", "scope": "path", "risk": "safe", "category": "错误报告",
     "pattern": "[/\\\\]WER[/\\\\](ReportArchive|ReportQueue)[/\\\\]",
     "description": "Windows 错误报告归档", "method": "清空"},
    {"id": "win-update-cache", "scope": "path", "risk": "safe", "category": "系统缓存",
     "pattern": "SoftwareDistribution[/\\\\](Download|DataStore)[/\\\\]",
     "description": "Windows Update 下载/数据缓存", "method": "停 wuauserv 后清空"},
    {"id": "delivery-optimization", "scope": "path", "risk": "safe", "category": "系统缓存",
     "pattern": "DeliveryOptimization[/\\\\](Cache|Logs)[/\\\\]",
     "description": "传递优化缓存", "method": "停 DoSvc 后清空"},
    {"id": "prefetch", "scope": "path", "risk": "safe", "category": "系统缓存",
     "pattern": "[/\\\\]Prefetch[/\\\\]",
     "description": "预读取缓存", "method": "清空"},
    {"id": "recycle-bin", "scope": "path", "risk": "safe", "category": "回收站",
     "pattern": "[/\\\\]\\$Recycle[.]Bin[/\\\\]",
     "description": "回收站内容", "method": "清空"},
    {"id": "junk-ext-files", "scope": "filename", "risk": "safe", "category": "垃圾文件",
     "pattern": "[.](tmp|temp|log|dmp|etl|chk|partial|crdownload|part|download)$",
     "description": "临时/日志/转储/下载中断文件", "method": "删除"},
    {"id": "backup-files", "scope": "filename", "risk": "warning", "category": "备份/旧文件",
     "pattern": "[.](old|bak)$",
     "description": "备份或旧版本文件，可能含用户需要的数据", "method": "确认后删"},
    {"id": "thumbcache", "scope": "filename", "risk": "safe", "category": "缩略图缓存",
     "pattern": "^(thumbcache_\\d+|iconcache_\\d+)[.]db$",
     "description": "缩略图/图标缓存", "method": "删除"},
    {"id": "electron-updater", "scope": "path", "risk": "safe", "category": "更新残留",
     "pattern": "@[^\\\\/]+-desktop-updater[\\\\/]installer[.]exe$",
     "description": "Electron 应用更新安装包残留", "method": "删除 installer.exe"},
    {"id": "installer-residue", "scope": "path", "risk": "warning", "category": "安装包残留",
     "pattern": "[/\\\\](installer|setup)[^\\\\/]*[.](exe|msi)$",
     "description": "安装包/安装器残留", "method": "确认已安装后删"},
    {"id": "msi-orphan", "scope": "path", "risk": "warning", "category": "安装器缓存",
     "pattern": "Windows[/\\\\]Installer[/\\\\].*[.](msi|msp)$",
     "description": "Windows Installer 缓存（仅孤儿可删）", "method": "PatchCleaner 识别"},
    {"id": "old-version-dir", "scope": "path", "risk": "warning", "category": "旧版本残留",
     "pattern": "[/\\\\][vV]?\\d+[.]\\d+([.]\\d+)?[/\\\\]",
     "description": "版本号目录（软件旧版残留）", "method": "确认非当前版本后删"},
    {"id": "node-modules", "scope": "dirname", "risk": "warning", "category": "开发依赖",
     "pattern": "^node_modules$",
     "description": "项目依赖（死项目可删）", "method": "确认项目不用后删"},
    {"id": "dev-cache-npm", "scope": "path", "risk": "safe", "category": "开发缓存",
     "pattern": "npm-cache[/\\\\]",
     "description": "npm 缓存", "method": "npm cache clean --force"},
    {"id": "dev-cache-python", "scope": "path", "risk": "safe", "category": "开发缓存",
     "pattern": "[/\\\\](pip|uv|pypoetry)[/\\\\](Cache|cache)[/\\\\]",
     "description": "Python 包缓存", "method": "pip cache purge / uv cache clean"},
    {"id": "dev-cache-jvm", "scope": "path", "risk": "warning", "category": "开发缓存",
     "pattern": "([.]gradle[/\\\\]caches|[.]m2[/\\\\]repository)[/\\\\]",
     "description": "Gradle/Maven 缓存", "method": "确认后删"},
    {"id": "ml-model-cache", "scope": "path", "risk": "warning", "category": "AI模型缓存",
     "pattern": "[.]cache[/\\\\](huggingface|torch|whisper)|[.]ollama[/\\\\]models",
     "description": "AI/ML 模型缓存", "method": "按模型逐个确认"},
    {"id": "docker-wsl-vhdx", "scope": "filename", "risk": "danger", "category": "容器/虚拟机",
     "pattern": "^(docker_data|ext4)[.]vhdx$",
     "description": "Docker/WSL 虚拟磁盘", "method": "用 docker system prune / wsl，勿直接删"}
  ]
}
